{
  "name": "media-player-v2",
  "version": "1.2.0",
  "description": "Lecteur web auto-hébergé de comics/mangas (LAN/VPN privé)",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "init": "node scripts/init.js",
    "postinstall": "node scripts/init.js --yes || echo ''",
    "rescan": "node scripts/rescan.js",
    "hash-password": "node scripts/hash-password.js",
    "doctor": "node scripts/doctor.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:e2e": "npx playwright test tests/e2e/",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "supertest": "^7.0.0"
  }
}